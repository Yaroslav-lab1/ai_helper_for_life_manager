# Core environment
ENVIRONMENT=development
DOMAIN=
DATABASE_URL=sqlite:///./axel.db
# Generate for production: openssl rand -hex 32
SECRET_KEY=development-only-change-before-production
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
TRUSTED_PROXIES=127.0.0.1,::1

# Docker PostgreSQL. Set unique values in the real .env; never reuse these placeholders.
POSTGRES_DB=axel
POSTGRES_USER=axel
POSTGRES_PASSWORD=replace-with-a-unique-random-database-password

# Authentication controls
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_ATTEMPTS=8
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
EMAIL_TOKEN_MINUTES=30
USE_SECURE_AUTH_COOKIES=false
REFRESH_COOKIE_NAME=axel_refresh
REFRESH_COOKIE_SAMESITE=lax

# Email. Production validation requires smtp, host and from address.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=

# Explicit development-only demo seed. Keep disabled in production.
ENABLE_DEMO_SEED=false
DEMO_EMAIL=demo@axel.one
DEMO_PASSWORD=
VITE_ENABLE_DEMO_LOGIN=false

# Frontend build-time API address
VITE_API_URL=http://localhost:8000/api/v1

# AI provider: ollama, gigachat or mock
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_MESSAGE_CHARS=4000
AI_MAX_CONTEXT_CHARS=16000
AI_MAX_CONCURRENT_GENERATIONS=2
PRIVACY_POLICY_VERSION=2026-07-28

# GigaChat. Never commit the real Authorization Key.
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_REQUEST_TIMEOUT_SECONDS=120
GIGACHAT_VERIFY_SSL=true
# GIGACHAT_CA_BUNDLE_FILE=/absolute/path/to/russian_trusted_root_ca.pem
