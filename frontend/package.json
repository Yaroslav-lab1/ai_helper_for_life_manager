{
  "name": "axel-one-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "npm run test:unit && npm run test:legacy",
    "test:unit": "TZ=Europe/Moscow vitest run",
    "test:unit:watch": "TZ=Europe/Moscow vitest",
    "test:legacy": "node --test tests/*.test.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "30.0.1",
    "typescript": "latest",
    "vitest": "4.1.11"
  }
}
